rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function activeMember() {
      return request.auth != null
        && get(/databases/$(database)/documents/helperPanelMembers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/helperPanelMembers/$(request.auth.uid)).data.role
          in ['Administrator', 'Moderator'];
    }

    function validBoard() {
      return request.resource.data.keys().hasOnly(['helpers', 'logs', 'revision'])
        && request.resource.data.helpers is list
        && request.resource.data.logs is list
        && request.resource.data.logs.size() <= 1000
        && request.resource.data.revision is int;
    }

    match /helperPanelMembers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if activeMember();
      allow write: if false;
    }

    match /helperPanel/main {
      allow get: if activeMember();
      allow create: if activeMember() && validBoard() && request.resource.data.revision == 1;
      allow update: if activeMember() && validBoard()
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
